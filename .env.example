# MySQL (or MariaDB / TiDB) connection string used by the Python app.
# The seed script auto-creates the `wardrobe_python` database if it is missing,
# so you do not need to create it by hand.
#
# Local MySQL example:
#   DATABASE_URL="mysql://root:password@127.0.0.1:3306/wardrobe_python"
#
# Cloud / TLS example (TiDB, AWS RDS, etc.):
#   DATABASE_URL="mysql://user:pass@host:4000/wardrobe_python?ssl=true"
DATABASE_URL="mysql://root:password@127.0.0.1:3306/wardrobe_python"
